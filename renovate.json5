{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: [
		'config:recommended',
		':semanticCommits',
		// Every dependency bump should cut a release so the deployed image doesn't lag. The preset
		// is needed because config:recommended adds a packageRule that makes deps `chore`, and
		// packageRules beat a top-level semanticCommitType.
		':semanticCommitTypeAll(fix)'
	],
	pinDigests: true,
	rebaseWhen: 'conflicted',
	packageRules: [
		{
			groupName: 'svelte',
			matchPackageNames: [
				'svelte',
				'svelte-check',
				'runed',
				'/^@sveltejs//',
				'prettier-plugin-svelte',
				'eslint-plugin-svelte'
			]
		},
		{
			groupName: 'vitest',
			matchPackageNames: ['vitest', '/^@vitest//']
		},
		{
			groupName: 'eslint',
			matchPackageNames: [
				'eslint',
				'@eslint/js',
				'/^eslint-config-/',
				'/^eslint-plugin-/',
				'typescript-eslint'
			]
		},
		{
			groupName: 'drizzle',
			matchPackageNames: ['drizzle-orm', 'drizzle-kit']
		},
		{
			matchManagers: ['mise'],
			semanticCommitScope: 'mise',
			commitMessageTopic: 'tool {{depName}}'
		},
		{ matchUpdateTypes: ['major'], labels: ['type/major'] },
		{ matchUpdateTypes: ['minor'], labels: ['type/minor'] },
		{ matchUpdateTypes: ['patch'], labels: ['type/patch'] },
		{ matchUpdateTypes: ['digest'], labels: ['type/digest'] },
		{ matchManagers: ['github-actions'], addLabels: ['renovate/github-action'] },
		{ matchManagers: ['dockerfile'], addLabels: ['renovate/container'] },
		{ matchManagers: ['mise'], addLabels: ['renovate/mise'] }
	]
}
